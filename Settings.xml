<?xml version="1.0" encoding="utf-8"?>
<ElectroHud>
  <Enabled>true</Enabled>
  <RightMargin>0.018</RightMargin>
  <TopOffset>0.125</TopOffset>
  <BottomMargin>0.045</BottomMargin>
  <Scale>0.75</Scale>
  <ShowTerritory>true</ShowTerritory>
  <ShowVehicle>true</ShowVehicle>
  <SuppressReplacedLsrIndicators>true</SuppressReplacedLsrIndicators>
  <Opacity>0.86</Opacity>
  <Diagnostics>false</Diagnostics>
  <Animate>true</Animate>
  <HideInMenus>true</HideInMenus>
  <HideInScenes>true</HideInScenes>
  <ToggleKey>F9</ToggleKey>
  <Cyan>#33ECFF</Cyan>
  <Magenta>#F354F8</Magenta>
  <Health><Enabled>true</Enabled><Color>#50FF92</Color><CriticalPercent>25</CriticalPercent></Health>
  <Armor><Enabled>true</Enabled><Color>#82D1FF</Color><CriticalPercent>25</CriticalPercent></Armor>
  <Hunger><Enabled>true</Enabled><Color>#FFA94F</Color><CriticalPercent>25</CriticalPercent></Hunger>
  <Thirst><Enabled>true</Enabled><Color>#36E6FF</Color><CriticalPercent>25</CriticalPercent></Thirst>
  <Sleep><Enabled>true</Enabled><Color>#AC7DFF</Color><CriticalPercent>25</CriticalPercent></Sleep>
  <!-- Oculto enquanto não houver uma fonte real de estresse. -->
  <Stress><Enabled>true</Enabled><Color>#FF68BA</Color><CriticalPercent>25</CriticalPercent></Stress>
  <Fuel><Enabled>true</Enabled><Color>#5488FF</Color><CriticalPercent>15</CriticalPercent></Fuel>
</ElectroHud>
