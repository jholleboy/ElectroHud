+
+    // Optional snapshot producer with expiring display acknowledgements.
+    internal sealed class ElectroHudSnapshotPublisher : IDisposable
+    {
+        private const int Size = 8192;
+        private const int Magic = 0x45485235;
+        private System.IO.MemoryMappedFiles.MemoryMappedFile map;
+        private System.IO.MemoryMappedFiles.MemoryMappedViewAccessor view;
+        private System.Threading.Mutex mutex;
+        private bool disabled;
+        private long visibleStamp;
+        private int visibleMask;
+        private uint visibleVehicle;
+        private const int DiagnosticsBit = 1 << 30;
+        private readonly Dictionary<long, PublishedFrame> recent = new Dictionary<long, PublishedFrame>();
+        private readonly Queue<long> publicationOrder = new Queue<long>();
+        private PublishedFrame acknowledged;
+        private bool diagnostics;
+        private readonly Dictionary<int, string> diagnosticsState = new Dictionary<int, string>();
+        private readonly Dictionary<int, long> textLogTime = new Dictionary<int, long>();
+
+        private sealed class PublishedFrame
+        {
+            public string Zone, Street, Status, Vehicle;
+            public global::Street Limit;
+        }
+
+        public bool MatchesLimit(Street street)
+        {
+            var previous = acknowledged?.Limit;
+            return previous != null && street != null &&
+                (ReferenceEquals(previous, street) || (previous.ElectroHudUsesFallbackLimit
+                    && street.ElectroHudUsesFallbackLimit && previous.Name == street.Name
+                    && previous.ElectroHudSpeedLimitKMH == street.ElectroHudSpeedLimitKMH));
+        }
+
+        private void Report(int key, string state, string detail)
+        {
+            if (!diagnostics || (diagnosticsState.TryGetValue(key, out string prior) && prior == state))
+                return;
+            if (key <= -64)
+            {
+                long now = Stopwatch.GetTimestamp();
+                if (textLogTime.TryGetValue(key, out long last) && now - last < Stopwatch.Frequency * 3)
+                    return;
+                textLogTime[key] = now;
+            }
+            diagnosticsState[key] = state;
+            Game.LogTrivial("[ElectroHud bridge] " + detail);
+        }
+
+        public int VisibleMask
+        {
+            get
+            {
+                long age = Stopwatch.GetTimestamp() - visibleStamp;
+                return visibleStamp > 0 && age >= 0 && age <= Stopwatch.Frequency * 3 / 4 ? visibleMask : 0;
+            }
+        }
+
+        public bool IsVisible(int bit, uint vehicleHandle) =>
+            vehicleHandle != 0 && visibleVehicle == vehicleHandle && (VisibleMask & bit) != 0;
+
+        public bool ShowsText(int bit, string text)
+        {
+            if (string.IsNullOrWhiteSpace(text))
+                return false;
+            string confirmed = bit == 64 ? acknowledged?.Zone : bit == 128 ? acknowledged?.Street
+                : bit == 512 ? acknowledged?.Status : acknowledged?.Vehicle;
+            bool shown = (VisibleMask & bit) != 0 && text == confirmed;
+            string reason = shown ? "confirmado" : (VisibleMask & bit) == 0
+                ? "sem confirmação vigente de desenho" : "texto original mudou desde a confirmação";
+            Report(bit, reason, $"bloco {bit}: {reason} | {text}");
+            return shown;
+        }
+
+        public void Publish(ModController controller)
+        {
+            if (!controller.IsRunning || disabled)
+                return;
+            try
+            {
+                var player = controller.Player;
+                var manager = controller.ModDataFileManager?.Settings?.SettingsManager;
+                var ped = player?.Character;
+                if (player == null || manager == null || ped == null || !ped.Exists() || player.HumanState == null)
+                    return;
+
+                var needs = manager.NeedsSettings;
+                var vehicleOptions = manager.VehicleSettings;
+                int flags = controller.IsDisplayingAlertScreen || player.IsShowingFrontEndMenus
+                    || player.IsDisplayingCustomMenus ? 1 : 0;
+                if (vehicleOptions.UseCustomFuelSystem) flags |= 2;
+                if (needs.ApplyNeeds && needs.ApplyHunger) flags |= 8;
+                if (needs.ApplyNeeds && needs.ApplyThirst) flags |= 16;
+                if (needs.ApplyNeeds && needs.ApplySleep) flags |= 32;
+                float hunger = player.HumanState.Hunger?.CurrentValue ?? float.NaN;
+                float thirst = player.HumanState.Thirst?.CurrentValue ?? float.NaN;
+                float sleep = player.HumanState.Sleep?.CurrentValue ?? float.NaN;
+                uint handle = 0;
+                float fuel = float.NaN;
+                var tracked = player.CurrentVehicle;
+                var current = ped.IsInAnyVehicle(false) ? ped.CurrentVehicle : null;
+                if (current != null && current.Exists() && tracked?.Vehicle != null
+                    && tracked.Vehicle.Exists() && current.Handle == tracked.Vehicle.Handle)
+                {
+                    handle = (uint)current.Handle;
+                    if (tracked.RequiresFuel)
+                    {
+                        flags |= 4;
+                        if (vehicleOptions.UseCustomFuelSystem && vehicleOptions.CustomFuelSystemFuelMax > 0)
+                            fuel = current.FuelLevel * 100f / vehicleOptions.CustomFuelSystemFuelMax;
+                    }
+                }
+
+                var location = player.CurrentLocation;
+                var zone = location?.CurrentZone;
+                var street = location?.CurrentStreet;
+                float limit = float.NaN;
+                if (handle != 0 && (player.IsInAutomobile || player.IsOnMotorcycle))
+                {
+                    flags |= 256;
+                    if (street != null)
+                    {
+                        float candidate = street.ElectroHudSpeedLimitKMH;
+                        if (candidate > 0 && !float.IsInfinity(candidate))
+                        {
+                            bool fallback = street.ElectroHudUsesFallbackLimit;
+                            bool registered = !string.IsNullOrWhiteSpace(street.Name)
+                                && ReferenceEquals(street, controller.ModDataFileManager.Streets.GetStreet(street.Name));
+                            if (fallback || registered)
+                            {
+                                flags |= fallback ? 512 : 128;
+                                limit = candidate;
+                            }
+                        }
+                    }
+                }
+                if (player.IsInSearchMode) flags |= 64;
+                if (handle != 0 && player.Violations.TrafficViolations.IsFelonySpeeding) flags |= 1024;
+                var display = controller.ElectroHudDisplay;
+                string zoneText = display?.ElectroHudZone;
+                string streetText = display?.ElectroHudStreet;
+                string pursuit = display?.ElectroHudStatus;
+                string recognition = handle == 0 ? null : display?.GetElectroHudVehicleContext();
+
+                if (view == null)
+                {
+                    string channel;
+                    using (var process = Process.GetCurrentProcess())
+                        channel = @"Local\ElectroHud.Lsr.v5." + process.Id;
+                    mutex = new System.Threading.Mutex(false, channel + ".Lock");
+                    map = System.IO.MemoryMappedFiles.MemoryMappedFile.CreateOrOpen(channel, Size);
+                    view = map.CreateViewAccessor(0, Size);
+                }
+                bool held = false;
+                try
+                {
+                    try { held = mutex.WaitOne(0); }
+                    catch (System.Threading.AbandonedMutexException)
+                    {
+                        held = true;
+                        view.Write(48, 0L);
+                    }
+                    if (!held)
+                        return;
+                    long now = Stopwatch.GetTimestamp();
+                    while (publicationOrder.Count > 0 && now - publicationOrder.Peek() > Stopwatch.Frequency * 2)
+                        recent.Remove(publicationOrder.Dequeue());
+                    int receivedMask = view.ReadInt32(8184);
+                    diagnostics = (receivedMask & DiagnosticsBit) != 0;
+                    long confirmedAt = view.ReadInt64(48);
+                    long rendered = view.ReadInt64(56);
+                    if (confirmedAt == 0)
+                    {
+                        visibleStamp = 0;
+                        acknowledged = null;
+                    }
+                    else if (confirmedAt >= rendered && confirmedAt <= now &&
+                        now - rendered < Stopwatch.Frequency && recent.TryGetValue(rendered, out var frame))
+                    {
+                        visibleMask = receivedMask & ~DiagnosticsBit;
+                        visibleVehicle = view.ReadUInt32(8188);
+                        visibleStamp = confirmedAt;
+                        acknowledged = frame;
+                    }
+                    string result = confirmedAt == 0 ? "sem desenho confirmado" : acknowledged == null
+                        ? "snapshot confirmado ausente ou antigo" : $"máscara de desenho {VisibleMask}";
+                    Report(-1, result, "confirmação RC2: " + result);
+                    int limitSource = flags & (128 | 512);
+                    Report(-2, limitSource.ToString(), $"limite publicado: {(limitSource == 128 ? "cadastrado" : limitSource == 512 ? "padrão" : "indisponível")}");
+                    view.Write(8, 0L);
+                    view.Write(0, Magic);
+                    view.Write(4, handle);
+                    view.Write(16, hunger);
+                    view.Write(20, thirst);
+                    view.Write(24, sleep);
+                    view.Write(28, fuel);
+                    view.Write(32, flags);
+                    view.Write(36, player.WantedLevel);
+                    view.Write(40, limit);
+                    int offset = 64;
+                    var published = new PublishedFrame
+                    {
+                        Zone = WriteText(ref offset, 64, zoneText),
+                        Street = WriteText(ref offset, 128, streetText),
+                        Status = WriteText(ref offset, 512, pursuit),
+                        Vehicle = WriteText(ref offset, 1024, recognition),
+                        Limit = float.IsNaN(limit) ? null : street
+                    };
+                    WriteText(ref offset, 1, zone?.AssignedLEAgency?.ShortName);
+                    WriteText(ref offset, 2, zone?.AssignedGang?.ShortName);
+                    WriteText(ref offset, 3, zone?.DisplayName);
+                    view.Write(44, offset - 64);
+                    long stamp = Stopwatch.GetTimestamp();
+                    recent[stamp] = published;
+                    publicationOrder.Enqueue(stamp);
+                    view.Write(8, stamp);
+                    Report(-64, published.Zone, "zona publicada: " + published.Zone);
+                    Report(-128, published.Street, "rua publicada: " + published.Street);
+                    Report(-512, published.Status, "estado publicado: " + published.Status);
+                    Report(-1024, published.Vehicle, "veículo publicado: " + published.Vehicle);
+                    Report(-3, (VisibleMask & 56).ToString(),
+                        $"necessidades confirmadas: {VisibleMask & 56}; a linha RC2 não tem fundo próprio. Sombra e contorno acompanham o texto restante.");
+                }
+                finally
+                {
+                    if (held)
+                        mutex.ReleaseMutex();
+                }
+            }
+            catch (System.Threading.ThreadAbortException) { throw; }
+            catch (Exception ex)
+            {
+                disabled = true;
+                Dispose();
+                Game.LogTrivial("[ElectroHud bridge] Publicação desativada: " + ex.GetBaseException().Message);
+            }
+        }
+
+        private string WriteText(ref int offset, int id, string text)
+        {
+            if (string.IsNullOrWhiteSpace(text))
+                return null;
+            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(text);
+            if (bytes.Length > 8184 - offset - 8)
+                return null;
+            view.Write(offset, id);
+            view.Write(offset + 4, bytes.Length);
+            view.WriteArray(offset + 8, bytes, 0, bytes.Length);
+            offset += 8 + bytes.Length;
+            return text;
+        }
+
+        public void Dispose()
+        {
+            visibleStamp = 0;
+            if (view != null && mutex != null)
+            {
+                bool held = false;
+                try
+                {
+                    try { held = mutex.WaitOne(0); }
+                    catch (System.Threading.AbandonedMutexException) { held = true; }
+                    if (held)
+                    {
+                        view.Write(8, 0L);
+                        view.Write(32, 2048);
+                    }
+                }
+                catch (System.IO.IOException) { }
+                catch (ObjectDisposedException) { }
+                finally
+                {
+                    if (held) mutex.ReleaseMutex();
+                }
+            }
+            view?.Dispose();
+            map?.Dispose();
+            mutex?.Dispose();
+            view = null;
+            map = null;
+            mutex = null;
+        }
+    }
 }
