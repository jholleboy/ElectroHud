+    // Optional snapshot producer with expiring display acknowledgements.
+    internal sealed class ElectroHudSnapshotPublisher : IDisposable
+    {
+        private const int Size = 8192;
+        private const int Magic = 0x45485234;
+        private System.IO.MemoryMappedFiles.MemoryMappedFile map;
+        private System.IO.MemoryMappedFiles.MemoryMappedViewAccessor view;
+        private System.Threading.Mutex mutex;
+        private bool disabled;
+        private long visibleStamp;
+        private int visibleMask;
+        private uint visibleVehicle;
+        private long publishedStamp;
+        private string publishedZone, publishedStreet, publishedPursuit, publishedRecognition;
+        private string visibleZone, visibleStreet, visiblePursuit, visibleRecognition;
+        private Street publishedLimitStreet;
+        public Street VisibleStreet { get; private set; }
+
+
+        public int VisibleMask
+        {
+            get
+            {
+                long age = Stopwatch.GetTimestamp() - visibleStamp;
+                return visibleStamp > 0 && age >= 0 && age <= Stopwatch.Frequency * 3 / 4 ? visibleMask : 0;
+            }
+        }
+
+        public bool IsVisible(int bit, uint vehicleHandle) =>
+            vehicleHandle != 0 && visibleVehicle == vehicleHandle && (VisibleMask & bit) != 0;
+
+        public bool ShowsText(int bit, string text)
+        {
+            if ((VisibleMask & bit) == 0 || string.IsNullOrWhiteSpace(text))
+                return false;
+            string acknowledged = bit == 64 ? visibleZone : bit == 128 ? visibleStreet
+                : bit == 512 ? visiblePursuit : visibleRecognition;
+            return text == acknowledged;
+        }
+
+        public void Publish(ModController controller)
+        {
+            if (!controller.IsRunning || disabled)
+                return;
+            try
+            {
+                var player = controller.Player;
+                var manager = controller.ModDataFileManager?.Settings?.SettingsManager;
+                var ped = player?.Character;
+                if (player == null || manager == null || ped == null || !ped.Exists() || player.HumanState == null)
+                    return;
+
+                var needs = manager.NeedsSettings;
+                var vehicleOptions = manager.VehicleSettings;
+                int flags = controller.IsDisplayingAlertScreen || player.IsShowingFrontEndMenus
+                    || player.IsDisplayingCustomMenus ? 1 : 0;
+                if (vehicleOptions.UseCustomFuelSystem) flags |= 2;
+                if (needs.ApplyNeeds && needs.ApplyHunger) flags |= 8;
+                if (needs.ApplyNeeds && needs.ApplyThirst) flags |= 16;
+                if (needs.ApplyNeeds && needs.ApplySleep) flags |= 32;
+                float hunger = player.HumanState.Hunger?.CurrentValue ?? float.NaN;
+                float thirst = player.HumanState.Thirst?.CurrentValue ?? float.NaN;
+                float sleep = player.HumanState.Sleep?.CurrentValue ?? float.NaN;
+                uint handle = 0;
+                float fuel = float.NaN;
+                var tracked = player.CurrentVehicle;
+                var current = ped.IsInAnyVehicle(false) ? ped.CurrentVehicle : null;
+                if (current != null && current.Exists() && tracked?.Vehicle != null
+                    && tracked.Vehicle.Exists() && current.Handle == tracked.Vehicle.Handle)
+                {
+                    handle = (uint)current.Handle;
+                    if (tracked.RequiresFuel)
+                    {
+                        flags |= 4;
+                        if (vehicleOptions.UseCustomFuelSystem && vehicleOptions.CustomFuelSystemFuelMax > 0)
+                            fuel = current.FuelLevel * 100f / vehicleOptions.CustomFuelSystemFuelMax;
+                    }
+                }
+
+                var location = player.CurrentLocation;
+                var zone = location?.CurrentZone;
+                var street = location?.CurrentStreet;
+                float limit = float.NaN;
+                if (handle != 0 && (player.IsInAutomobile || player.IsOnMotorcycle))
+                {
+                    flags |= 256;
+                    if (!string.IsNullOrWhiteSpace(street?.Name)
+                        && ReferenceEquals(street, controller.ModDataFileManager.Streets.GetStreet(street.Name)))
+                    {
+                        float registered = street.ElectroHudSpeedLimitKMH;
+                        if (registered > 0 && !float.IsInfinity(registered))
+                        {
+                            flags |= 128;
+                            limit = registered;
+                        }
+                    }
+                    else if (street != null)
+                        flags |= 512; // LocationData's synthetic record is not a posted limit.
+                }
+                if (player.IsInSearchMode) flags |= 64;
+                if (handle != 0 && player.Violations.TrafficViolations.IsFelonySpeeding) flags |= 1024;
+                var display = controller.ElectroHudDisplay;
+                string zoneText = display?.GetZoneDisplay();
+                string streetText = display?.GetStreetDisplay(true);
+                string pursuit = display?.GetElectroHudPursuit();
+                string recognition = handle == 0 ? null : display?.GetElectroHudVehicleContext();
+
+                if (view == null)
+                {
+                    string channel;
+                    using (var process = Process.GetCurrentProcess())
+                        channel = @"Local\ElectroHud.Lsr.v4." + process.Id;
+                    mutex = new System.Threading.Mutex(false, channel + ".Lock");
+                    map = System.IO.MemoryMappedFiles.MemoryMappedFile.CreateOrOpen(channel, Size);
+                    view = map.CreateViewAccessor(0, Size);
+                }
+                bool held = false;
+                try
+                {
+                    try { held = mutex.WaitOne(0); }
+                    catch (System.Threading.AbandonedMutexException)
+                    {
+                        held = true;
+                        view.Write(48, 0L);
+                    }
+                    if (!held)
+                        return;
+                    long confirmedAt = view.ReadInt64(48);
+                    if (confirmedAt == 0)
+                    {
+                        visibleStamp = 0;
+                    }
+                    else if (publishedStamp != 0 && view.ReadInt64(56) == publishedStamp)
+                    {
+                        visibleMask = view.ReadInt32(8184);
+                        visibleVehicle = view.ReadUInt32(8188);
+                        visibleStamp = confirmedAt;
+                        visibleZone = publishedZone;
+                        visibleStreet = publishedStreet;
+                        visiblePursuit = publishedPursuit;
+                        visibleRecognition = publishedRecognition;
+                        VisibleStreet = publishedLimitStreet;
+                    }
+                    view.Write(8, 0L);
+                    view.Write(0, Magic);
+                    view.Write(4, handle);
+                    view.Write(16, hunger);
+                    view.Write(20, thirst);
+                    view.Write(24, sleep);
+                    view.Write(28, fuel);
+                    view.Write(32, flags);
+                    view.Write(36, player.WantedLevel);
+                    view.Write(40, limit);
+                    int offset = 64;
+                    publishedZone = WriteText(ref offset, 64, zoneText);
+                    publishedStreet = WriteText(ref offset, 128, streetText);
+                    publishedPursuit = WriteText(ref offset, 512, pursuit);
+                    publishedRecognition = WriteText(ref offset, 1024, recognition);
+                    WriteText(ref offset, 1, zone?.AssignedLEAgency?.ShortName);
+                    WriteText(ref offset, 2, zone?.AssignedGang?.ShortName);
+                    WriteText(ref offset, 3, zone?.DisplayName);
+                    view.Write(44, offset - 64);
+                    publishedLimitStreet = float.IsNaN(limit) ? null : street;
+                    publishedStamp = Stopwatch.GetTimestamp();
+                    view.Write(8, publishedStamp);
+                }
+                finally
+                {
+                    if (held)
+                        mutex.ReleaseMutex();
+                }
+            }
+            catch (System.Threading.ThreadAbortException) { throw; }
+            catch (Exception ex)
+            {
+                disabled = true;
+                Dispose();
+                Game.LogTrivial("[ElectroHud bridge] Publicação desativada: " + ex.GetBaseException().Message);
+            }
+        }
+
+        private string WriteText(ref int offset, int id, string text)
+        {
+            if (string.IsNullOrWhiteSpace(text))
+                return null;
+            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(text);
+            if (bytes.Length > 8184 - offset - 8)
+                return null;
+            view.Write(offset, id);
+            view.Write(offset + 4, bytes.Length);
+            view.WriteArray(offset + 8, bytes, 0, bytes.Length);
+            offset += 8 + bytes.Length;
+            return text;
+        }
+
+        public void Dispose()
+        {
+            visibleStamp = 0;
+            view?.Dispose();
+            map?.Dispose();
+            mutex?.Dispose();
+            view = null;
+            map = null;
+            mutex = null;
+        }
+    }
 }
